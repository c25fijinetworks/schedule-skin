---
import Hero from '~/components/widgets/Hero.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import { lifetimeDeal } from '~/data/pricingData';

const metadata = { 
  title: 'The Story | Launch.Skin', 
  description: 'Why we build boutique websites for the world’s best skin clinics.' 
};
---
<Layout metadata={metadata}>
  <Hero2
    tagline="The Story"
    title='Elite Websites for <span class="text-accent">Elite Practitioners</span>'
    subtitle="We believe your digital address should be as pristine as the results you create in the treatment room. Your website is your digital handshake, and it should reflect your expertise."
    actions={[{ variant: 'primary', text: 'Secure My Address', href: '/pricing/' }]}
    image={{ src: '/images/hero-poster.webp', alt: 'Launch.Skin Professional Branding' }}
  />
  
  <Content
    isReversed={false}
    items={[
        { 
          title: 'Mirror Your Luxury', 
          description: 'You’ve spent thousands designing your clinical space. Your digital home should mirror that luxury and signal expertise before a patient even books.', 
          icon: 'tabler:award' 
        },
        { 
          title: 'Focus on Results, Not Tech', 
          description: 'Practitioners are medical artists, not web developers. We handle the servers, code, and integrations so you can focus on clinical excellence.', 
          icon: 'tabler:brush' 
        },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">Our Technical Philosophy</h3>
      <p class="text-lg text-muted">In the modern aesthetic industry, "Generic" is the enemy of "Expertise." We provide a clean, dedicated digital address that establishes you as a local authority.</p>
    </Fragment>
    <Fragment slot="image">
       <img src="/images/testimonial-4.webp" alt="Elite clinic procedure" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <Content
    isReversed={true}
    items={[
        { 
          title: 'A New Standard for Clinics', 
          description: 'Your best work is already on social media; we simply give it the high-end gallery it deserves on a professional domain with automated Sync.', 
          icon: 'tabler:rocket' 
        },
        { 
          title: 'White-Glove Support', 
          description: 'When you join Launch.Skin, you get a dedicated backend team. We handle the technical heavy lifting so you can stay in the treatment room.', 
          icon: 'tabler:headset' 
        },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">The Digital Address Difference</h3>
      <p class="text-lg text-muted">Whether you are a solo practitioner or a clinic owner, your digital address is your most valuable asset. It is where your reputation lives online.</p>
    </Fragment>
    <Fragment slot="image">
       <img src="/images/testimonial-3.webp" alt="Skin practitioner working" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <Pricing 
    class="pb-0"
    title="Ready to Own Your Professional Identity?" 
    prices={[lifetimeDeal]} 
  />

  <Hero class="-mt-16">
    <Fragment slot="image">
      <img src="/images/testimonial-6.webp" alt="Clinic website preview" class="mx-auto rounded-md w-full shadow-lg" loading="lazy" />
    </Fragment>
  </Hero>
</Layout>
