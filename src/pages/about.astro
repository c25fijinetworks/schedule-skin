---
import Hero from '~/components/widgets/Hero.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Layout from '~/layouts/PageLayout.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import { lifetimeDeal } from '~/data/pricingData';

const metadata = { 
  title: 'Our Mission | Schedule.Skin', 
  description: 'Why we build boutique vanity URLs for the world’s best skin clinics.' 
};
---
<Layout metadata={metadata}>
  <Hero2
    tagline="The Professional Standard"
    title='Elite Vanity URLs for <span class="text-accent">Elite Practitioners</span>'
    subtitle="We believe your digital address should be as pristine as the results you create in the treatment room. A professional vanity URL is your digital handshake, and it should reflect your medical expertise."
    actions={[{ variant: 'primary', text: 'Secure My Vanity URL', href: '/pricing/' }]}
    image={{ src: '/images/hero-poster.webp', alt: 'Schedule.Skin Professional Branding' }}
  />
  
  <Content
    isReversed={false}
    items={[
        { 
          title: 'Mirror Your Luxury', 
          description: 'You’ve spent thousands designing your clinical space. Your vanity URL should mirror that luxury and signal expertise before a patient even books.', 
          icon: 'tabler:award' 
        },
        { 
          title: 'Focus on Patients, Not Tech', 
          description: 'Practitioners are medical artists, not web developers. We handle the redirection and same-day setup so you can stay in the treatment room.', 
          icon: 'tabler:brush' 
        },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">Our Technical Philosophy</h3>
      <p class="text-lg text-muted">In the modern aesthetic industry, a generic booking link is a liability. We provide a clean, dedicated vanity URL that establishes you as a local authority.</p>
    </Fragment>
    <Fragment slot="image">
       <img src="/images/testimonial-4.webp" alt="Elite clinic procedure" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <Content
    isReversed={true}
    items={[
        { 
          title: 'A New Standard for Clinics', 
          description: 'Your best work is already on social media; we simply give it the high-end gallery it deserves on a professional vanity URL with automated sync.', 
          icon: 'tabler:rocket' 
        },
        { 
          title: 'White-Glove Setup', 
          description: 'When you join Schedule.Skin, you get a dedicated backend team. We handle the technical heavy lifting so you can stay focused on clinical excellence.', 
          icon: 'tabler:headset' 
        },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-3xl font-bold mb-4">The Digital Address Difference</h3>
      <p class="text-lg text-muted">Whether you are a solo practitioner or a clinic owner, your vanity URL is your most valuable digital asset. It is where your reputation lives online.</p>
    </Fragment>
    <Fragment slot="image">
       <img src="/images/testimonial-3.webp" alt="Skin practitioner working" class="rounded-lg shadow-xl w-full" />
    </Fragment>
  </Content>

  <Pricing 
    class="pb-0"
    title="Ready to Own Your Professional Identity?" 
    prices={[lifetimeDeal]} 
  />

  <Hero class="-mt-16">
    <Fragment slot="image">
      <img src="/images/testimonial-6.webp" alt="Clinic website preview" class="mx-auto rounded-md w-full shadow-lg" loading="lazy" />
    </Fragment>
  </Hero>
</Layout>
