---
import Layout from '~/layouts/PageLayout.astro';
const metadata = { title: 'Privacy Policy | Schedule.Skin' };
---
<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
    <h1 class="font-bold font-heading text-4xl md:text-5xl mb-8">Privacy Policy</h1>
    <div class="prose prose-lg dark:prose-invert">
      <p>At <strong>Schedule.Skin</strong>, we prioritize clinic and patient privacy. We collect only the data necessary to provide your professional URL redirection.</p>
    </div>
  </section>
</Layout>
