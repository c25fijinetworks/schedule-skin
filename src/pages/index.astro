---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features from '~/components/widgets/Features.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Content from '~/components/widgets/Content.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import { headerData } from '~/navigation';
import FAQs from '~/components/widgets/FAQs.astro';
import { lifetimeDeal } from '~/data/pricingData';

const metadata = { 
  title: 'Launch.Skin | Boutique Websites for Skin Clinics', 
  description: 'Your Practice Deserves a Digital Masterpiece. High-end websites with automated Instagram sync and vanity URLs for elite aesthetic professionals.' 
};
---
<Layout metadata={metadata}>
  <Fragment slot="header"><Header {...headerData} isSticky /></Fragment>
  
  <Hero2
    tagline="Boutique Web Development for Clinics"
    title='<span class="text-accent dark:text-white">Your Practice Deserves a Digital Masterpiece.</span>'
    subtitle="We build elegant, high-converting websites that sync with your clinical results in real-time. Stand out with a professional address while you focus on your patients."
    actions={[{ variant: 'primary', text: "Claim Your Clinic's Website", href: '/pricing/' }, { text: 'See How It Works', href: '#howitworks' }]}
    image={{ src: '/images/hero-poster.webp', width: 1024, height: 576 }}
  />

  <Features
    class="-mt-16"
    id="features"
    title="Everything Your Practice Needs"
    subtitle="Essential elements of a high-performance skin clinic website distilled into a single package."
    items={[
        { 
          title: 'Aesthetic Medical Design', 
          description: 'Custom-crafted layouts that mirror the clean, clinical vibe of your treatment rooms. We prioritize high-resolution imagery that tells your brand story.', 
          icon: 'tabler:palette' 
        },
        { 
          title: 'Automated Result Feeds', 
          description: 'We sync your Instagram directly to your homepage gallery. Every time you post a fresh transformation, your website updates automatically. Zero manual effort.', 
          icon: 'tabler:brand-instagram' 
        },
        { 
          title: 'Conversion Strategy', 
          description: 'We integrate your primary booking engine into a clear layout. We optimize the path from search to scheduled treatment for mobile users.', 
          icon: 'tabler:info-circle' 
        },
        { 
          title: 'Professional Technical Suite', 
          description: 'Hosting, SSL security, and global delivery. We handle the enterprise-grade tech so your portfolio loads instantly on any device.', 
          icon: 'tabler:cloud-computing' 
        },
    ]}
  />

  <Content
    class="-mt-16"
    tagline="Always Current. Zero Stress."
    title="Your site stays as fresh as your latest procedure."
    items={[
        { title: 'Real-time Instagram Sync', description: 'Your portfolio updates automatically every time you post a new treatment result.', icon: 'tabler:refresh' },
        { title: 'Automatic Content Refresh', description: 'No more outdated websites. Your latest work is always front and center.', icon: 'tabler:camera' },
        { title: 'Authority SEO Signal', description: 'Google prioritizes clinics with professional dedicated URLs over generic social links.', icon: 'tabler:trending-up' },
    ]}
    image={{ src: '/images/testimonial-2.webp', alt: 'Practitioner working on a patient' }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        <span class="text-accent dark:text-white">Instant Results Portfolio</span>
      </h3>
      <p>We automatically sync your latest posts directly to your homepage so your site reflects your current clinical expertise 24/7.</p>
    </Fragment>
    <Fragment slot="bg"><div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div></Fragment>
  </Content>

  <div id="howitworks" class="scroll-mt-20">
    <Steps2
      title="The Path to a Better Presence"
      subtitle="Three simple steps to your clinic's new digital home."
      items={[
        { title: '01. Sign up with your brand', description: 'Secure your clinic identity and choose your vanity URL.', icon: 'tabler:number-1' },
        { title: '02. We Build & Sync', description: 'Our studio crafts your site and connects your social feeds for auto-updates.', icon: 'tabler:number-2' },
        { title: '03. Launch & Shine', description: 'Go live on launch.skin/yourclinic and start attracting high-value patients.', icon: 'tabler:number-3' },
      ]}
      image={{ src: '/images/testimonial-6.webp', alt: 'Launch Skin process' }}
    />
  </div>

  <Pricing title='<span class="text-accent dark:text-white">Ready to elevate your clinical brand?</span>' prices={[lifetimeDeal]} />

  <FAQs
    class="-mt-16 px-6"
    title="Deep Dive: How Launch.Skin Works"
    items={[
        { title: 'What is a Vanity URL?', description: 'A branded link like <strong>launch.skin/yourclinic</strong>. It replaces messy links in your bio with a professional medical presence.', icon: 'tabler:link' },
        { title: 'Is it really "Same-Day"?', description: 'Yes. If you submit your details by 2 PM, our team builds and deploys your site before you close for the day.', icon: 'tabler:bolt' },
        { title: 'Is this a monthly subscription?', description: 'No. Launch.Skin is a one-time investment. We charge for setup and hosting once. You own it for life.', icon: 'tabler:coin' },
        { title: 'Do I need tech skills?', description: 'None. Your site stays fresh by syncing with your Instagram. If you can post a photo, you can maintain your site.', icon: 'tabler:tool' },
    ]}
  >
     <Fragment slot="bg"><div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div></Fragment>
  </FAQs>
</Layout>
