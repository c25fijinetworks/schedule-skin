---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features from '~/components/widgets/Features.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Content from '~/components/widgets/Content.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import { headerData } from '~/navigation';
import FAQs from '~/components/widgets/FAQs.astro';
import { lifetimeDeal } from '~/data/pricingData';

const metadata = { title: 'Schedule.Skin | The Pro Choice for Skin Clinic Vanity URLs', description: 'Replace generic links with a beautiful skin care scheduling page on your own professional .skin domain.' };
---
<Layout metadata={metadata}>
  <Fragment slot="header"><Header {...headerData} isSticky /></Fragment>
  <Hero2
    tagline="Boutique Web Development for Skin Clinics"
    title='<span class="text-accent dark:text-white">Your Clinic. Your Domain. Your Rules.</span>'
    subtitle="Generic booking links look unprofessional. We build you a branded vanity booking URL (yourclinic.schedule.skin) that integrates directly with your Google Business Profile. Same-day setup, zero tech stress."
    actions={[{ variant: 'primary', text: 'Get Your Booking Link Today', href: '/pricing/' }, { text: 'See How It Works', href: '#howitworks' }]}
    image={{ src: '/images/hero-poster.webp', width: 1024, height: 576 }}
  />
  <Features
    id="features"
    title="Dominate Your Local Market"
    items={[
        { title: 'The "Schedule" Button Pro', description: 'We link your vanity URL to the official Google "Schedule" button so patients can book directly from Search.', icon: 'tabler:brand-google' },
        { title: 'Branded .Skin URLs', description: 'Ditch the messy ID strings. Own a link that signals authority in dermatology and aesthetics.', icon: 'tabler:link' },
        { title: 'Clinical Design', description: 'Every app is custom-styled to match your clinic’s clean, professional interior.', icon: 'tabler:palette' },
        { title: 'Same-Day Delivery', description: 'Order by 2PM, and your professional booking engine is live before your next consultation.', icon: 'tabler:bolt' },
    ]}
  />
  <div id="howitworks" class="scroll-mt-20">
    <Steps2
      title="Same-Day Professional Setup"
      items={[
        { title: '1. Claim Your .Skin URL', description: 'Pick your clinic name and secure the $99 lifetime license.', icon: 'tabler:number-1' },
        { title: '2. We Build the Engine', description: 'Our team builds your mobile-first booking app and styles it to your medical brand.', icon: 'tabler:number-2' },
        { title: '3. Sync & Treat', description: 'We drop the link into your Google Profile and Instagram. Start taking appointments instantly.', icon: 'tabler:number-3' },
      ]}
      image={{ src: '/images/testimonial-6.webp', alt: 'Skin Clinic interface' }}
    />
  </div>
  <Pricing title='One-Time Investment. Forever Access.' prices={[lifetimeDeal]} />
  <FAQs
    title="Deep Dive: How Schedule.Skin Works"
    subtitle="Everything you need to know about upgrading your clinic's digital presence."
    items={[
        { title: 'What is a "Vanity URL" for Skin Clinics?', description: 'Instead of "app.provider.com/x/123", we provide <strong>glow.schedule.skin</strong>. It looks medical-grade, professional, and is easy for patients to remember.', icon: 'tabler:link' },
        { title: 'Do I need to change my current software?', description: 'No. Schedule.Skin acts as the "Elite Front Door" to your existing calendar, making the booking experience feel like a luxury service.', icon: 'tabler:device-laptop' },
    ]}
  />
</Layout>
