---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features from '~/components/widgets/Features.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Content from '~/components/widgets/Content.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import { headerData } from '~/navigation';
import FAQs from '~/components/widgets/FAQs.astro';
import { lifetimeDeal } from '~/data/pricingData';

const metadata = { 
  title: 'Schedule.Skin | Boutique Vanity URLs for Skin Clinics', 
  description: 'Your Practice Deserves a Digital Masterpiece. High-end vanity URLs with automated Instagram sync and same-day setup for elite aesthetic professionals.' 
};
---
<Layout metadata={metadata}>
  <Fragment slot="header"><Header {...headerData} isSticky /></Fragment>
  
  <Hero2
    tagline="Boutique Web Development for Clinics"
    title='<span class="text-accent dark:text-white">Elite Clinics Deserve an Elite Digital Address.</span>'
    subtitle="Generic booking links look clinical but cheap. We build you an elegant, high-converting vanity URL (yourclinic.schedule.skin) that syncs with your clinical results in real-time. Own your digital address while you focus on your patients."
    actions={[{ variant: 'primary', text: "Claim Your Vanity URL", href: '/pricing/' }, { text: 'See How It Works', href: '#howitworks' }]}
    image={{ src: '/images/hero-poster.webp', width: 1024, height: 576 }}
  />

  <Features
    class="-mt-16"
    id="features"
    title="Dominate Your Local Aesthetic Market"
    subtitle="Essential elements of a high-performance clinical vanity URL distilled into a single package."
    items={[
        { 
          title: 'Premium Vanity URL', 
          description: 'Ditch the messy ID strings from generic booking tools. Own a clean, memorable vanity URL that establishes medical authority instantly.', 
          icon: 'tabler:link' 
        },
        { 
          title: 'Automated Result Feeds', 
          description: 'We sync your Instagram directly to your vanity URL homepage. Every time you post a fresh transformation, your site updates automatically.', 
          icon: 'tabler:brand-instagram' 
        },
        { 
          title: 'Google "Book Online" Pro', 
          description: 'We help you link your new vanity URL to the official Google Business Profile "Book Online" button for maximum SEO impact.', 
          icon: 'tabler:brand-google' 
        },
        { 
          title: 'White-Glove Delivery', 
          description: 'If you order by 2PM, your vanity URL and clinical portal are live before you finish your final treatment of the day.', 
          icon: 'tabler:bolt' 
        },
    ]}
  />

  <Content
    class="-mt-16"
    tagline="Always Current. Zero Stress."
    title="A vanity URL that reflects your current expertise."
    items={[
        { title: 'Real-time Instagram Sync', description: 'Your clinical portfolio updates automatically every time you post a new patient result.', icon: 'tabler:refresh' },
        { title: 'Branded Redirect Flow', description: 'Patients see your brand first, creating a luxury bridge between social media and your booking engine.', icon: 'tabler:award' },
        { title: 'Luxury Patient Journey', description: 'Eliminate the "cheap" feel of generic redirection tools. Provide a seamless, high-end experience from the first click.', icon: 'tabler:sparkles' },
    ]}
    image={{ src: '/images/testimonial-2.webp', alt: 'Practitioner working on a patient' }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        <span class="text-accent dark:text-white">Why a Vanity URL is Your Best Digital Handshake</span>
      </h3>
      <p>We automatically sync your latest results directly to your vanity URL homepage so your digital presence matches your skill in the treatment room.</p>
    </Fragment>
    <Fragment slot="bg"><div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div></Fragment>
  </Content>

  <div id="howitworks" class="scroll-mt-20">
    <Steps2
      title="Same-Day Professional Setup"
      subtitle="Three simple steps to your clinic's new professional identity."
      items={[
        { title: '01. Claim Your Brand', description: 'Secure your clinic identity and choose your unique vanity URL name.', icon: 'tabler:number-1' },
        { title: '02. We Build & Sync', description: 'Our studio crafts your portal and connects your social feeds for auto-updates.', icon: 'tabler:number-2' },
        { title: '03. Launch & Shine', description: 'Go live on [yourname].schedule.skin and start attracting high-value patients instantly.', icon: 'tabler:number-3' },
      ]}
      image={{ src: '/images/testimonial-6.webp', alt: 'Schedule Skin process' }}
    />
  </div>

  <Pricing title='<span class="text-accent dark:text-white">Ready to own your vanity URL?</span>' prices={[lifetimeDeal]} />

  <FAQs
    class="-mt-16 px-6"
    title="Frequently Asked Questions"
    items={[
        { title: 'What exactly is a "Vanity URL"?', description: 'Most booking software gives you a messy link like "app.vagaro.com/u/123-abc". We replace that with a clean address like <strong>velvet.schedule.skin</strong>.', icon: 'tabler:link' },
        { title: 'Is it really "Same-Day" Setup?', description: 'Yes. If you submit your details by 2 PM, our team builds and deploys your vanity URL before you close for the day.', icon: 'tabler:bolt' },
        { title: 'Is this a monthly subscription?', description: 'No. Schedule.Skin is a one-time investment. We charge for setup and technical redirection once. You own it for life.', icon: 'tabler:coin' },
        { title: 'Do I need tech skills?', description: 'None. Your site stays fresh by syncing with your Instagram. If you can post a photo, you can maintain your presence.', icon: 'tabler:tool' },
    ]}
  >
     <Fragment slot="bg"><div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div></Fragment>
  </FAQs>
</Layout>
