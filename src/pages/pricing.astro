---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Features3 from '~/components/widgets/Features3.astro';
import { lifetimeDeal } from '~/data/pricingData';
import Hero from '~/components/widgets/Hero.astro';

const metadata = { 
  title: 'Pricing | Secure Your Elite Schedule.Skin Vanity URL', 
  description: 'Professional clinic vanity URLs with zero monthly fees. Transform your Google Business Profile and Social Bio into a luxury portfolio.' 
};
---
<Layout metadata={metadata}>
  <HeroText 
    tagline="The Professional Standard"
    title="A Stunning Home for Your Expertise. Live in Hours." 
    subtitle="More than just a link—it's your clinic's digital flagship. Own a beautiful vanity URL (yourclinic.schedule.skin) that transforms your social bio into a high-end experience."
  />

  <div class="-mt-16">
    <Pricing prices={[lifetimeDeal]} />
  </div>

  <Features3
    title="Elevate Every Touchpoint"
    subtitle="We bridge the gap between your hard work in the clinic and your presence online."
    columns={3}
    items={[
      { title: 'Vanity URL Transformation', description: 'Ditch generic link tools. Your vanity URL provides a high-end experience that keeps patients focused on your results.', icon: 'tabler:link' },
      { title: 'Google Business Authority', description: 'Replace generic links on your Google Profile with a dedicated vanity URL that creates a massive authority signal.', icon: 'tabler:brand-google' },
      { title: 'Live Portfolio Sync', description: 'We pull your live Instagram results directly onto your unique URL, ensuring your portfolio is always current.', icon: 'tabler:brand-instagram' },
      { title: 'Clinical Menu Styling', description: 'Present your procedures with medical-grade styling, detailing your specialties beautifully.', icon: 'tabler:clipboard-list' },
      { title: 'One-Time License', description: 'No monthly SaaS Taxes. Pay once and own your professional identity for life. We handle the technical redirection.', icon: 'tabler:coin' },
      { title: 'White-Glove Delivery', description: 'From setup to result syncing, we handle the technical heavy lifting with guaranteed same-day delivery.', icon: 'tabler:headset' },
    ]}
  />

  <FAQs
    class="-mt-16 px-6"
    title="Pricing & Setup Questions"
    items={[
        { title: 'How does same-day setup work?', description: 'Secure your license, fill out our brief form, and if received by 2PM EST, your vanity URL goes live before the business day ends.', icon: 'tabler:bolt' },
        { title: 'Can I use a standalone domain?', description: 'Yes! We can manage your standalone .com or .skin domain for just $15/year, handling all redirection and SSL setup for you.', icon: 'tabler:world' },
        { title: 'Is this a monthly fee?', description: 'No. Schedule.Skin is a one-time investment for setup and clinical branding. You never pay a monthly fee again.', icon: 'tabler:coin' },
        { title: 'Does this replace my booking software?', description: 'No. We provide the "Luxury Front Door" that points to your existing engine (Jane, Vagaro, etc.), replacing their messy links with your premium vanity URL.', icon: 'tabler:door-enter' },
    ]}
  >
    <Fragment slot="bg"><div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div></Fragment>
  </FAQs>

  <Hero class="-mt-16">
    <Fragment slot="image">
      <img src="/images/testimonial-5.webp" alt="Practitioner reviewing feedback" class="mx-auto rounded-md w-full shadow-lg" loading="lazy" />
    </Fragment>
  </Hero>
</Layout>
