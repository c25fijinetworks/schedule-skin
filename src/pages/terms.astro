---
import Layout from '~/layouts/PageLayout.astro';
const metadata = { title: 'Terms of Service | Schedule.Skin' };
---
<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
    <h1 class="font-bold font-heading text-4xl md:text-5xl mb-8">Terms of Service</h1>
    <div class="prose prose-lg dark:prose-invert">
      <p>Welcome to <strong>Schedule.Skin</strong>. By using our services, you agree to these terms regarding your clinic's professional vanity URL.</p>
      <h3>1. Service</h3>
      <p>Schedule.Skin provides a technical setup for skin care clinics, including custom vanity URLs (yourclinic.schedule.skin).</p>
      <h3>2. Payments</h3>
      <p>The $99 fee is a one-time setup fee for a lifetime license to the vanity URL redirect service.</p>
    </div>
  </section>
</Layout>
