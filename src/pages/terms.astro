---
import Layout from '~/layouts/PageLayout.astro';
const metadata = { title: 'Terms of Service | Schedule.Skin' };
---
<Layout metadata={metadata}>
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
    <h1 class="font-bold font-heading text-4xl md:text-5xl mb-8">Terms of Service</h1>
    <div class="prose prose-lg dark:prose-invert">
      <p>Welcome to <strong>Schedule.Skin</strong>. By using our service, you agree to these terms regarding your clinic's vanity URL and setup.</p>
      <p>Our service provides a one-time setup for skin care professionals. The $99 fee is a lifetime license for the configured redirect and landing page.</p>
    </div>
  </section>
</Layout>
