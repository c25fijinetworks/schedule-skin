---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import GoogleContactForm from '~/components/widgets/GoogleContactForm.astro';
import Features from '~/components/widgets/Features.astro';
import Hero from '~/components/widgets/Hero.astro';

const metadata = {
  title: 'Contact | Launch.Skin',
  description: 'Reach out for white-glove setup or support for your clinic website.',
};
---
<Layout metadata={metadata}>
  <HeroText 
    tagline="Support"
    title="We handle everything." 
    subtitle="Have questions about the Launch.Skin Concept? Our team is ready to help your clinic shine online."
  />
  <GoogleContactForm />

  <Features
    class="-mt-16"
    columns={3}
    items={[
      { title: 'Multi-Room Discounts', description: 'Running a large clinic or multiple spa locations? Contact us for bulk pricing on 3+ vanity URLs.', icon: 'tabler:building-store' },
      { title: 'White-Glove Support', description: 'Need help with your Google Business integration? Our technical team is here to assist.', icon: 'tabler:headset' },
      { title: 'Partner Program', description: 'Are you a clinical consultant or brand educator? Let’s talk about working together.', icon: 'tabler:users' },
    ]}
  />

  <Hero class="-mt-16" image={{ src: '/images/testimonial-7.webp', alt: 'Launch.Skin happy practitioner' }} />
</Layout>
